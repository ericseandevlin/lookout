{
  "manifest_version": 3,
  "name": "Lookout Autofill",
  "version": "0.2.0",
  "description": "Fills your approved Lookout application on the job's own page. You check it and press Submit.",
  "browser_specific_settings": {
    "gecko": { "id": "lookout-autofill@ericdevlin.co", "strict_min_version": "128.0", "data_collection_permissions": { "required": ["none"] } }
  },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "action": { "default_title": "Lookout Autofill", "default_popup": "popup.html", "default_icon": { "48": "icon.svg" } },
  "background": { "scripts": ["background.js"] },
  "permissions": ["storage", "scripting", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"]
}
