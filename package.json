    "mammoth": "^1.13.0",
    "next": "16.4.6",
    "nodemailer": "^10.4.0",
    "playwright-core": "^1.65.0",
    "postgres": "^4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "undici": "^8.12.4",
