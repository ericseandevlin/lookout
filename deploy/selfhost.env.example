# Self-host settings for compose.yaml. scripts/selfhost-env.sh copies this to .env and fills the secrets.
# Never commit .env.

# Filled by scripts/selfhost-env.sh. Don't change APP_SECRET after you've saved keys in the app.
POSTGRES_PASSWORD=
SEARXNG_SECRET=
APP_SECRET=

# You. Admins can always sign in, even in invite mode.
ADMIN_EMAILS=
SIGNUP_MODE=invite
APP_URL=http://localhost:3000

# No SMTP: sign-in links print to the app log (docker compose logs app).
# To send real email, set SMTP_URL (e.g. smtps://user:pass@smtp.example.com:465) and MAIL_FROM, and drop EMAIL_DEV_LOG.
EMAIL_DEV_LOG=1
SMTP_URL=
MAIL_FROM=Lookout <lookout@localhost>

# Bring your own model. You can also set these in Admin > AI settings after you sign in (the app wins once saved).
# Any OpenAI-compatible API (OpenRouter, DeepInfra, Together, Groq, Ollama):
AI_PROVIDER=openai
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=deepseek/deepseek-v4.1-flash
AI_API_KEY=
# Anthropic instead: AI_PROVIDER=anthropic, AI_MODEL=<a Claude model id>, AI_API_KEY=<your key>
# Ollama instead: AI_BASE_URL=http://host.docker.internal:11434/v1, AI_MODEL=<a model you've pulled>, no key.

# Web search runs on the bundled SearXNG. Nothing to set.
SEARCH_PROVIDER=searxng

APP_TZ=America/New_York
# Spend caps in US dollars per rolling 24 hours, all users and per user.
DAILY_BUDGET_USD=5
USER_DAILY_BUDGET_USD=2
FEATURE_AUTO_APPLY=off
