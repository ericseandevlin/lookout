# Copy to /opt/lookout/.env on the server (chmod 600). Never commit the real file.
APP_URL=https://findsboard.com
# Other hostnames that serve the app (same-origin check on writes)
EXTRA_ORIGINS=https://paulfinds.pauljustinscott.com
DATABASE_URL=postgres://lookout:CHANGE_ME@db:5432/lookout
# 32+ random chars; encrypts API keys saved from Admin > AI settings. Never change it after keys are saved.
APP_SECRET=
# AI and search defaults. Admin > AI settings overrides these at runtime.
AI_PROVIDER=openai
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=
AI_API_KEY=
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://searxng:8080
# RFP searches (#272): free key from a SAM.gov account. Leave empty to keep RFP search off.
SAM_API_KEY=
SIGNUP_MODE=invite
ADMIN_EMAILS=
ALLOWED_EMAILS=
SMTP_URL=
MAIL_FROM=Lookout <hello@findsboard.com>
APP_TZ=America/New_York
DAILY_BUDGET_USD=15
USER_DAILY_BUDGET_USD=3

# Feature flags. Auto-apply is beta: on in staging only until it's released.
FEATURE_AUTO_APPLY=off

# Replies to Lookout emails go here (the From address can't receive). Defaults to the first ADMIN_EMAILS address.
# MAIL_REPLY_TO=
